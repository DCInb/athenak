# Uniform one-group source problem with an intentionally non-monotonic temperature
# residual.  Run through run_nonlinear_coupling_nonmonotonic.py so the opacity path and
# output directory are staged independently of the caller's working directory.

<job>
basename = nonlinear_coupling_nonmonotonic

<mesh>
nghost = 2
nx1 = 8
x1min = -16.0
x1max = 16.0
ix1_bc = periodic
ox1_bc = periodic
nx2 = 1
x2min = -0.5
x2max = 0.5
ix2_bc = periodic
ox2_bc = periodic
nx3 = 1
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 8
nx2 = 1
nx3 = 1

<time>
evolution = dynamic
integrator = rk2
cfl_number = 0.4
nlim = 1
tlim = 1.0
ndiag = 1
initial_dt = 1.0

<hydro>
eos = ideal
reconstruct = plm
rsolver = hllc
gamma = 1.6666666666666667
two_temperature = true
electron_heat_capacity_fraction = 0.5
initial_electron_temperature_ratio = 1.0
t_ei = -1.0

<thermal_radiation>
enabled = true
n_groups = 1
arad = 1.0
c_light = 1.0
initial_radiation_temperature = 0.1
flux_limiter = none
transport_integrator = implicit
implicit_preconditioner = jacobi
implicit_tolerance = 1.0e-10
implicit_max_iterations = 200
implicit_report = false
source_cfl = 0.0
source_integrator = nonlinear
source_report = true
couple_matter = true

group_bound_0 = 0.0
group_bound_1 = 100.0

opacity_model = table
opacity_table_file = test-2t/nonlinear_coupling_nonmonotonic.opacity
opacity_interpolation = linear
opacity_coordinate_interpolation = linear
opacity_density_scale = 1.0
opacity_temperature_scale = 1.0
opacity_group_bound_scale = 1.0
opacity_value_scale = 1.0

<problem>
pgen_name = shock_tube
shock_dir = 1
xshock = 0.0
dl = 1.0
pl = 1.0
ul = 0.0
vl = 0.0
wl = 0.0
dr = 1.0
pr = 1.0
ur = 0.0
vr = 0.0
wr = 0.0

<output1>
file_type = tab
variable = hydro_3t
data_format = %20.16e
dt = 1.0
slice_x2 = 0.0
slice_x3 = 0.0

<output2>
file_type = tab
variable = hydro_w_d
id = density
data_format = %20.16e
dt = 1.0
slice_x2 = 0.0
slice_x3 = 0.0
