# Uniform three-temperature relaxation test for 1, 2, and 4 GPU ranks.
# Physics matches inputs/hydro/two_temperature_mgfld.athinput; only the uniform
# mesh decomposition is enlarged to eight MeshBlocks so every rank owns work.

<job>
basename = two_temperature_mgfld

<mesh>
nghost = 2
nx1 = 64
x1min = -0.5
x1max = 0.5
ix1_bc = periodic
ox1_bc = periodic
nx2 = 1
x2min = -0.5
x2max = 0.5
ix2_bc = periodic
ox2_bc = periodic
nx3 = 1
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 8
nx2 = 1
nx3 = 1

<time>
evolution = dynamic
integrator = rk2
cfl_number = 0.4
nlim = -1
tlim = 0.1
ndiag = 1

<hydro>
eos = ideal
reconstruct = plm
rsolver = hllc
gamma = 1.6666666666666667
two_temperature = true
electron_heat_capacity_fraction = 0.5
initial_electron_temperature_ratio = 1.0
t_ei = -1.0

<thermal_radiation>
enabled = true
n_groups = 3
arad = 0.1
c_light = 1.0
initial_radiation_temperature = 0.2
flux_limiter = levermore-pomraning
flux_limit_coefficient = 1.0
source_integrator = nonlinear
source_report = false
source_cfl = 0.1
couple_matter = true
group_bound_0 = 0.0
group_bound_1 = 0.5
group_bound_2 = 2.0
group_bound_3 = 100.0
kappa_transport_0 = 100.0
kappa_transport_1 = 100.0
kappa_transport_2 = 100.0
kappa_absorption_0 = 0.5
kappa_absorption_1 = 0.5
kappa_absorption_2 = 0.5
kappa_emission_0 = 0.5
kappa_emission_1 = 0.5
kappa_emission_2 = 0.5

<problem>
pgen_name = shock_tube
shock_dir = 1
xshock = 0.0
dl = 1.0
pl = 1.0
ul = 0.0
vl = 0.0
wl = 0.0
dr = 1.0
pr = 1.0
ur = 0.0
vr = 0.0
wr = 0.0

<output1>
file_type = tab
variable = hydro_3t
data_format = %20.12e
dt = 0.1
slice_x2 = 0.0
slice_x3 = 0.0
