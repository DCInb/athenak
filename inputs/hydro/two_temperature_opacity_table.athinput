# Uniform 3T relaxation using density- and electron-temperature-dependent opacities.
# Run from the repository root so opacity_table_file resolves as written below.

<job>
basename = two_temperature_opacity_table

<mesh>
nghost = 2
nx1 = 8
x1min = -0.5
x1max = 0.5
ix1_bc = periodic
ox1_bc = periodic
nx2 = 1
x2min = -0.5
x2max = 0.5
ix2_bc = periodic
ox2_bc = periodic
nx3 = 1
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 8
nx2 = 1
nx3 = 1

<time>
evolution = dynamic
integrator = rk2
cfl_number = 0.4
nlim = 1
tlim = 0.01
ndiag = 1

<hydro>
eos = ideal
reconstruct = plm
rsolver = hllc
gamma = 1.6666666666666667
two_temperature = true
electron_heat_capacity_fraction = 0.5
initial_electron_temperature_ratio = 1.0
t_ei = -1.0

<thermal_radiation>
enabled = true
n_groups = 2
arad = 0.1
c_light = 1.0
initial_radiation_temperature = 0.5
flux_limiter = levermore-pomraning
source_cfl = 0.0
couple_matter = true

group_bound_0 = 0.0
group_bound_1 = 1.0
group_bound_2 = 100.0

opacity_model = table
opacity_table_file = inputs/hydro/two_temperature_opacity_table.dat
opacity_interpolation = linear
opacity_density_scale = 1.0
opacity_temperature_scale = 1.0
opacity_group_bound_scale = 1.0
opacity_value_scale = 1.0

<problem>
pgen_name = shock_tube
shock_dir = 1
xshock = 0.0
dl = 2.0
pl = 3.0
ul = 0.0
vl = 0.0
wl = 0.0
dr = 2.0
pr = 3.0
ur = 0.0
vr = 0.0
wr = 0.0

<output1>
file_type = tab
variable = hydro_3t
data_format = %20.16e
dt = 0.01
slice_x2 = 0.0
slice_x3 = 0.0
