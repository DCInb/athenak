# Uniform two-temperature MHD slab heated by a straight laser ray.

<job>
basename = two_temperature_laser

<mesh>
nghost = 2
nx1 = 64
x1min = 0.0
x1max = 1.0
ix1_bc = outflow
ox1_bc = outflow
nx2 = 1
x2min = -0.5
x2max = 0.5
ix2_bc = outflow
ox2_bc = outflow
nx3 = 1
x3min = -0.5
x3max = 0.5
ix3_bc = outflow
ox3_bc = outflow

<meshblock>
nx1 = 16
nx2 = 1
nx3 = 1

<time>
evolution = dynamic
integrator = rk2
cfl_number = 0.3
nlim = -1
tlim = 1.0e-4
ndiag = 1
initial_dt = -1.0

<mhd>
eos = ideal
reconstruct = plm
rsolver = hlle
gamma = 1.6666666666666667
two_temperature = true
dual_energy = true
electron_heat_capacity_fraction = 0.5
initial_electron_temperature_ratio = 1.0
t_ei = -1.0

<laser>
model = straight
deposition_target = electron
electron_temperature_model = two_temperature
absorption_model = constant
absorption_coefficient = 1.0
unit_system = code
length_scale_cgs = 1.0
density_scale_cgs = 1.0
temperature_scale_cgs = 1.0
power_scale_cgs = 1.0
electron_number_per_gram = 1.0
critical_reflection = false
oblique_turning = true
max_reflections_per_ray = 8
reflection_offset_fraction = 1.0e-10
nbeams = 1

# Inline FLASH-style shared pulse tables. Declared but disabled (npulses=0) so the
# regression suite can enable them from the command line.
npulses = 0
pulse0_nsections = 4
pulse0_time_0 = 0.0
pulse0_time_1 = 0.0
pulse0_time_2 = 0.0
pulse0_time_3 = 0.0
pulse0_power_0 = 0.0
pulse0_power_1 = 0.0
pulse0_power_2 = 0.0
pulse0_power_3 = 0.0
pulse0_time_scale = 1.0
pulse0_power_scale = 1.0
max_segments_per_launch = 16
max_transport_iterations = 16
max_mpi_waves = 1024
gpu_aware_mpi = false
minimum_power_fraction = 1.0e-14
conservation_tolerance = 1.0e-10
periodic_transport = false
report_diagnostics = true

beam0_power = 1.0
beam0_wavelength = 1.0
beam0_nrays = 1
beam0_geometry = direction
beam0_origin_x1 = 0.0
beam0_origin_x2 = 0.0
beam0_origin_x3 = 0.0
beam0_direction_x1 = 1.0
beam0_direction_x2 = 0.0
beam0_direction_x3 = 0.0
beam0_lens_x1 = 0.0
beam0_lens_x2 = 0.0
beam0_lens_x3 = 0.0
beam0_target_x1 = 1.0
beam0_target_x2 = 0.0
beam0_target_x3 = 0.0
beam0_radius = 0.0
beam0_profile_radius = 1.0
beam0_target_radius = 0.0
beam0_profile = uniform
beam0_zeff = 1.0
beam0_start_time = 0.0
beam0_end_time = 1.0
beam0_pulse_file =
beam0_pulse_mode = relative
beam0_pulse_interpolation = linear
beam0_pulse_number = -1
beam0_pulse_time_scale = 1.0
beam0_pulse_power_scale = 1.0

<problem>
pgen_name = shock_tube
shock_dir = 1
xshock = 0.5
dl = 1.0
pl = 1.0
ul = 0.0
vl = 0.0
wl = 0.0
bxl = 0.0
byl = 0.0
bzl = 0.0
dr = 1.0
pr = 1.0
ur = 0.0
vr = 0.0
wr = 0.0
bxr = 0.0
byr = 0.0
bzr = 0.0

<output1>
file_type = hst
data_format = %20.12e
dt = 1.0e-4

<output2>
file_type = tab
variable = mhd_2t
id = two_temperature
data_format = %20.12e
dt = 1.0e-4
slice_x2 = 0.0
slice_x3 = 0.0

<output3>
file_type = tab
variable = laser
id = laser
data_format = %20.12e
dt = 1.0e-4
slice_x2 = 0.0
slice_x3 = 0.0

<output4>
file_type = bin
variable = laser
id = laser_full
dt = -1.0
