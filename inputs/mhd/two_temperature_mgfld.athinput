# Brio-Wu shock tube with ion/electron energies and two thermal-radiation groups.

<job>
basename = two_temperature_mgfld_mhd

<mesh>
nghost = 2
nx1 = 64
x1min = -0.5
x1max = 0.5
ix1_bc = outflow
ox1_bc = outflow
nx2 = 1
x2min = -0.5
x2max = 0.5
ix2_bc = periodic
ox2_bc = periodic
nx3 = 1
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 64
nx2 = 1
nx3 = 1

<time>
evolution = dynamic
integrator = rk2
cfl_number = 0.3
nlim = -1
tlim = 0.02
ndiag = 1

<mhd>
eos = ideal
reconstruct = plm
rsolver = hlld
gamma = 2.0
two_temperature = true
dual_energy = true
electron_heat_capacity_fraction = 0.5
initial_electron_temperature_ratio = 0.2
t_ei = 0.05

<thermal_radiation>
enabled = true
n_groups = 2
arad = 0.01
c_light = 1.0
initial_radiation_temperature = 0.1
flux_limiter = larsen
couple_matter = true
source_cfl = 0.1
source_integrator = nonlinear
source_report = false
group_bound_0 = 0.0
group_bound_1 = 1.0
group_bound_2 = 100.0
kappa_transport_0 = 100.0
kappa_transport_1 = 100.0
kappa_absorption_0 = 0.1
kappa_absorption_1 = 0.1

<problem>
pgen_name = shock_tube
shock_dir = 1
xshock = 0.0
dl = 1.0
pl = 1.0
ul = 0.0
vl = 0.0
wl = 0.0
bxl = 0.75
byl = 1.0
bzl = 0.0
dr = 0.125
pr = 0.1
ur = 0.0
vr = 0.0
wr = 0.0
bxr = 0.75
byr = -1.0
bzr = 0.0

<output1>
file_type = tab
variable = mhd_3t
data_format = %20.12e
dt = 0.02
slice_x2 = 0.0
slice_x3 = 0.0
