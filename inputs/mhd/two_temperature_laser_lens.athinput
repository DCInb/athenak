# Focused two-temperature MHD beam with a file-driven pulse.

<job>
basename = two_temperature_laser_lens

<mesh>
nghost = 2
nx1 = 32
x1min = 0.0
x1max = 1.0
ix1_bc = outflow
ox1_bc = outflow
nx2 = 32
x2min = -0.5
x2max = 0.5
ix2_bc = outflow
ox2_bc = outflow
nx3 = 32
x3min = -0.5
x3max = 0.5
ix3_bc = outflow
ox3_bc = outflow

<meshblock>
nx1 = 16
nx2 = 16
nx3 = 16

<time>
evolution = dynamic
integrator = rk2
cfl_number = 0.3
nlim = -1
tlim = 1.0e-4
ndiag = 10

<mhd>
eos = ideal
gamma = 1.6666666666666667
reconstruct = plm
rsolver = hlle
two_temperature = true
dual_energy = true
electron_heat_capacity_fraction = 0.5
initial_electron_temperature_ratio = 1.0
t_ei = -1.0

<laser>
model = straight
deposition_target = electron
electron_temperature_model = two_temperature
absorption_model = constant
absorption_coefficient = 1.0
unit_system = code
length_scale_cgs = 1.0
density_scale_cgs = 1.0
temperature_scale_cgs = 1.0
power_scale_cgs = 1.0
electron_number_per_gram = 1.0
critical_reflection = false
nbeams = 1
max_segments_per_launch = 16
max_transport_iterations = 64
max_mpi_waves = 1024
minimum_power_fraction = 1.0e-14
conservation_tolerance = 1.0e-10
periodic_transport = false
report_diagnostics = true

beam0_power = 1.0
beam0_wavelength = 1.0
beam0_nrays = 256
beam0_geometry = lens
beam0_lens_x1 = -0.25
beam0_lens_x2 = 0.0
beam0_lens_x3 = 0.0
beam0_target_x1 = 0.70
beam0_target_x2 = 0.0
beam0_target_x3 = 0.0
beam0_aperture_radius = 0.25
beam0_target_radius = 0.05
beam0_profile = gaussian
beam0_profile_radius = 0.18
beam0_zeff = 1.0
beam0_pulse_file = inputs/mhd/two_temperature_laser_ramp.pulse
beam0_pulse_mode = relative
beam0_pulse_interpolation = linear

<problem>
pgen_name = shock_tube
shock_dir = 1
xshock = 0.5
dl = 1.0
pl = 1.0
ul = 0.0
vl = 0.0
wl = 0.0
bxl = 0.0
byl = 0.0
bzl = 0.0
dr = 1.0
pr = 1.0
ur = 0.0
vr = 0.0
wr = 0.0
bxr = 0.0
byr = 0.0
bzr = 0.0

<output1>
file_type = hst
data_format = %20.12e
dt = 1.0e-4

<output2>
file_type = bin
variable = mhd_2t
id = two_temperature
dt = 1.0e-4

<output3>
file_type = bin
variable = laser
id = laser
dt = 1.0e-4
