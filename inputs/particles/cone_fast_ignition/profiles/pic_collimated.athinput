# Uniform DT transport adaptation of Strozzi cone-source models.
# Point of injection represents the source plane, not a simulated cone.
# 1 micron / 1 ps / 1e-12 g; Te=Ti=1 keV; constant eta; no burn.
<job>
basename = pic_collimated

<units>
length_cgs = 0.0001
mass_cgs = 1e-12
time_cgs = 1e-12
mu = 1.25

<mesh>
nghost = 2
nx1 = 16
x1min = 0
x1max = 64
ix1_bc = outflow
ox1_bc = outflow
nx2 = 16
x2min = -32
x2max = 32
ix2_bc = outflow
ox2_bc = outflow
nx3 = 16
x3min = -32
x3max = 32
ix3_bc = outflow
ox3_bc = outflow

<meshblock>
nx1 = 8
nx2 = 8
nx3 = 8

<time>
evolution = dynamic
integrator = rk2
cfl_number = 0.03
initial_dt = 0.02
tlim = 1.5
nlim = -1
ndiag = 20
align_outputs = false

<mhd>
eos = ideal
reconstruct = plm
rsolver = hlle
gamma = 1.6666666666666667
two_temperature = true
dual_energy = true
electron_heat_capacity_fraction = 0.5
initial_electron_temperature_ratio = 1
t_ei = -1

<fast_electrons>
electromagnetic = true
magnetic_diffusivity_cm2_s = 1000.0
field_cfl = 0.25
max_field_substeps = 100000
power_erg_s = 4.797547797372916e+21
start_time = 0
end_time = 1.0
origin_x1 = 0
origin_x2 = 0
origin_x3 = 0
source_radius = 18.0
source_cutoff = 1.5
source_radial_power = 8
source_radial_order = 8
source_azimuthal_points = 8
distribution_file = pic_collimated.dat
packets_per_bin = 1
electron_number_per_gram = 2.4088565160466963e+23
zeff = 1
coulomb_log = 10
collisions = true
scattering = true
thermalization_kev = 10
thermalization_factor = 3
max_fractional_loss = 0.05
max_scatter = 0.05
max_segments = 256
max_transport_waves = 10000
max_packets = 100000000
periodic_transport = false
report_diagnostics = true
seed = 12345

<problem>
pgen_name = shock_tube
shock_dir = 1
xshock = 32
dl = 450.0
pl = 34.73472262201796
ul = 0
vl = 0
wl = 0
bxl = 0
byl = 0
bzl = 0
dr = 450.0
pr = 34.73472262201796
ur = 0
vr = 0
wr = 0
bxr = 0
byr = 0
bzr = 0

<output1>
file_type = rst
dt = 1.5
single_file_per_rank = false
