# Frozen-coefficient multilevel regression with unequal group opacities and
# growing timesteps. All fields are output, including non-slice boundary cells.
<job>
basename = multilevel
<mesh>
nghost = 2
nx1 = 36
nx2 = 18
nx3 = 18
x1min = -0.5
x1max = 0.5
x2min = -0.4
x2max = 0.4
x3min = -0.25
x3max = 0.25
ix1_bc = outflow
ox1_bc = outflow
ix2_bc = outflow
ox2_bc = outflow
ix3_bc = outflow
ox3_bc = outflow
<meshblock>
nx1 = 18
nx2 = 18
nx3 = 18
<time>
evolution = dynamic
integrator = rk2
cfl_number = 0.4
nlim = 3
tlim = 0.0007
initial_dt = 0.0001
align_outputs = true
ndiag = 1
<hydro>
eos = ideal
reconstruct = plm
rsolver = hllc
gamma = 1.6666666666666667
two_temperature = true
electron_heat_capacity_fraction = 0.5
initial_electron_temperature_ratio = 1.0
t_ei = -1.0
<thermal_radiation>
enabled = true
n_groups = 2
arad = 1.0
c_light = 1000.0
transport_integrator = implicit
implicit_preconditioner = block-coarse
implicit_tolerance = 1.0e-11
implicit_max_iterations = 1000
implicit_report = true
implicit_x1_inner_boundary = neumann
implicit_x1_outer_boundary = neumann
implicit_x2_inner_boundary = neumann
implicit_x2_outer_boundary = neumann
implicit_x3_inner_boundary = neumann
implicit_x3_outer_boundary = neumann
implicit_x1_inner_value = 0.1
implicit_x1_outer_value = 0.1
implicit_x2_inner_value = 0.1
implicit_x2_outer_value = 0.1
implicit_x3_inner_value = 0.1
implicit_x3_outer_value = 0.1
initial_profile = step
initial_radiation_temperature = 1.0
initial_radiation_temperature_right = 0.5
initial_radiation_x1 = 0.0
flux_limiter = none
couple_matter = false
source_cfl = 0.0
group_bound_0 = 0.0
group_bound_1 = 1.0
group_bound_2 = 100.0
kappa_transport_0 = 100.0
kappa_transport_1 = 35.0
<problem>
pgen_name = shock_tube
shock_dir = 1
xshock = 0.0
dl = 1.0
pl = 1.0e-8
ul = 0.0
vl = 0.0
wl = 0.0
dr = 1.0
pr = 1.0e-8
ur = 0.0
vr = 0.0
wr = 0.0
<output1>
file_type = bin
variable = hydro_3t
dt = 0.0007
