# Self-checking two-temperature, constant-coefficient implicit-conduction regression.
# Three Fourier modes have a closed-form centered-space backward-Euler update.  The one
# step is more than 50 times the explicit parabolic limit, and the two MeshBlocks exercise
# solver-vector halo exchange both within one rank and when split across two MPI ranks.

<job>
basename = implicit_conduction

<mesh>
nghost = 3
nx1 = 64
x1min = 0.0
x1max = 1.0
ix1_bc = periodic
ox1_bc = periodic
nx2 = 1
x2min = 0.0
x2max = 1.0
ix2_bc = periodic
ox2_bc = periodic
nx3 = 1
x3min = 0.0
x3max = 1.0
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 32
nx2 = 1
nx3 = 1

<time>
evolution = kinematic
integrator = rk2
cfl_number = 0.4
nlim = 1
tlim = 1.0e-1
ndiag = 1
initial_dt = 1.0e-1

<hydro>
eos = ideal
reconstruct = dc
rsolver = advect
gamma = 1.6666666666666667
two_temperature = true
electron_heat_capacity_fraction = 5.0e-1
initial_electron_temperature_ratio = 1.0
t_ei = -1.0
alpha_iso = 5.0e-2
conduction_integrator = implicit
conduction_theta = 1.0
conduction_linear_tolerance = 1.0e-12
conduction_nonlinear_tolerance = 1.0e-12
conduction_max_iterations = 400
conduction_max_nonlinear_iterations = 4
conduction_flux_limiter = none
conduction_report = true

<units>
length_cgs = 1.0
mass_cgs = 1.0
time_cgs = 1.0
mu = 1.0

<problem>
boundary = periodic
temperature_background = 1.0
temperature_amplitude_1 = 1.5e-1
temperature_amplitude_2 = 1.0e-1
temperature_amplitude_3 = 5.0e-2
mode_1 = 1
mode_2 = 7
mode_3 = 13
error_tolerance = 2.0e-10
conservation_tolerance = 2.0e-12
