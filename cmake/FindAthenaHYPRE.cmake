# Optional BoomerAMG dependency. Use hypre's exported target so static CUDA/MPI
# dependencies are retained, without embedding site-specific paths.
set(HYPRE_ROOT "" CACHE PATH "hypre installation prefix")
cmake_policy(PUSH)
if (POLICY CMP0074)
  cmake_policy(SET CMP0074 NEW)
endif()
find_package(HYPRE 2.33 CONFIG REQUIRED HINTS ${HYPRE_ROOT}
    PATH_SUFFIXES lib/cmake/HYPRE lib64/cmake/HYPRE)
cmake_policy(POP)
if (NOT TARGET HYPRE::HYPRE)
  message(FATAL_ERROR "Athena_ENABLE_HYPRE requires hypre's HYPRE::HYPRE CMake target")
endif()
if (HYPRE_ENABLE_SINGLE OR HYPRE_ENABLE_LONG_DOUBLE OR HYPRE_ENABLE_COMPLEX)
  message(FATAL_ERROR "Athena_ENABLE_HYPRE requires real, double-precision hypre")
endif()
if (HYPRE_ENABLE_BIGINT)
  message(FATAL_ERROR "Athena_ENABLE_HYPRE requires 32-bit HYPRE_Int (MIXEDINT is valid)")
endif()
if (Athena_ENABLE_MPI AND NOT HYPRE_ENABLE_MPI)
  message(FATAL_ERROR "Athena MPI builds require an MPI-enabled hypre")
elseif (NOT Athena_ENABLE_MPI AND HYPRE_ENABLE_MPI)
  message(FATAL_ERROR "Athena serial builds require a non-MPI hypre")
endif()
if (Kokkos_ENABLE_CUDA)
  if (NOT HYPRE_ENABLE_CUDA OR HYPRE_ENABLE_UNIFIED_MEMORY)
    message(FATAL_ERROR "Athena CUDA AMG requires CUDA hypre without unified memory")
  endif()
elseif (HYPRE_ENABLE_CUDA OR HYPRE_ENABLE_HIP OR HYPRE_ENABLE_SYCL)
  message(FATAL_ERROR "Athena host AMG requires a host-only hypre")
endif()
if (Kokkos_ENABLE_HIP OR Kokkos_ENABLE_SYCL OR Kokkos_ENABLE_OPENMPTARGET)
  message(FATAL_ERROR "Athena AMG currently supports host or CUDA memory spaces")
endif()
